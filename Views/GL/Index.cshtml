@model IEnumerable<BankingApp.ViewModels.GLSummaryViewModel>

@{
    ViewData["Title"] = "GL Summary";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h1>GL Summary</h1>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">GL</a></li>
                <li class="breadcrumb-item active">Summary</li>
            </ol>
        </div>
        <a asp-action="Add" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add New GL
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-bold">
            <i class="fas fa-table me-1"></i> General Ledgers List
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>GL Number</th>
                        <th>Description</th>
                        <th>Currency</th>
                        <th>Branch</th>
                        <th>Allow Negative</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.GLNumber</td>
                                <td>@item.Description</td>
                                <td><span class="badge bg-secondary">@item.Currency</span></td>
                                <td>@item.BranchName</td>
                                <td>
                                    @if (item.AllowNegative)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No General Ledger accounts found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>